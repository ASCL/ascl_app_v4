# ASCL Secrets Configuration
#
# Copy to /etc/ascl/secrets.cfg and fill in actual values.
# Permissions: sudo chown root:www-data /etc/ascl/secrets.cfg && sudo chmod 640 /etc/ascl/secrets.cfg
#
# Override the default path with the ASCL_SECRETS_FILE environment variable.

SECRET_KEY = 'generate-a-random-key-here'
ADS_API_TOKEN = 'your-ads-api-token'
TYPESENSE_API_KEY = 'your-typesense-api-key'

# Sentry error tracking DSN. Leave empty to disable Sentry.
SENTRY_DSN = ''
