# ASCL.net Flask Application Environment Variables
# Copy this file to .env and fill in your actual values
# NOTE: .env is gitignored - never commit credentials to version control
# NOTE: This file is ONLY loaded in development (when FLASK_ENV != production)

# Flask Environment (default: development)
# FLASK_ENV=development

# Database Configuration
# Specify which section of ~/.my.cnf to use for database credentials
ASCLDB_MYCNF_SECTION=client_ascl

# Or override specific database connection parameters:
# ASCLDB_HOST=127.0.0.1
# ASCLDB_PORT=3306
# ASCLDB_USER=ascl_db
# ASCLDB_PASSWORD=your_password_here
# ASCLDB_DATABASE=ascl_db

# Flask Configuration
# FLASK_ENV=development
# FLASK_DEBUG=1

# Optional: Error tracking
# SENTRY_DSN=https://your-sentry-dsn-here
