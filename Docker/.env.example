# ASCL Database Configuration
# Copy this file to .env and update with your credentials

# Database user credentials (used by both Docker and Flask)
ASCLDB_USER=ascl_user
ASCLDB_PASSWORD=ascl_password

# MySQL root password (used by Docker only)
ASCLDB_ROOT_PASSWORD=ascl_root_password

# Note: ASCL MySQL runs on port 3307 (not the default 3306)
# Port 3306 is used by another MySQL instance on this system

# To use this file:
# 1. Copy to .env: cp .env.example .env
# 2. Update with your credentials
# 3. Source before running: source .env
# 4. Or use with docker-compose: docker-compose --env-file .env up -d
