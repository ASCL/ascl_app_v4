#!/usr/bin/env python3
"""
ascl — management CLI for the ASCL Flask application.

Usage:
    ascl restart [TARGET]      Restart the app (default target from config)
    ascl redeploy TARGET [-f]  Full redeploy (sync code, install deps, restart)
    ascl status [TARGET]       Show app/service status
    ascl config                Show resolved config for a target
    ascl typesense reset       Drop collection, recreate schema, re-index
    ascl typesense index       (Re-)index all published codes into Typesense
    ascl typesense status      Show collection info and document count
    ascl test <URL>            Run smoke tests against a live site
    ascl dumpdb <DATABASE>     Dump MySQL database to {name}_yyyy-mm-dd.sql
    ascl init                  Create default config at ~/.config/ascl/config.toml
    ascl completions bash      Print bash completion script
    ascl completions zsh       Print zsh completion script
"""

import argparse
import os
import pathlib
import subprocess
import sys
import time
import tomllib

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

# When run with sudo, $HOME becomes /root. Use SUDO_USER to find the real user's home.
_real_home = pathlib.Path(f"~{os.environ['SUDO_USER']}").expanduser() if os.environ.get("SUDO_USER") else pathlib.Path.home()
CONFIG_DIR = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", _real_home / ".config")) / "ascl"
CONFIG_FILE = CONFIG_DIR / "config.toml"

TARGETS = ("vps", "cpanel")

RSYNC_EXCLUDES = [
    "venv", ".venv", "__pycache__", "*.pyc", ".git",
    "logs/*.log", "*.egg-info", ".uv", ".claude",
]

DEFAULT_CONFIG = """\
# ASCL CLI configuration
# Generated by: ascl init

default_target = "vps"

# ---------------------------------------------------------------------------
# VPS target — Nginx + Uvicorn + systemd
# ---------------------------------------------------------------------------
[vps]
restart_method = "systemd"
service_name   = "ascl_net_app"

# Source repository (for rsync during redeploy)
repo_app = ""

# Where the running app is deployed to
deploy_app = "/var/www/ascl_net_app"

# File ownership after sync (leave empty to skip)
run_as_user = "www-data"

# Flask config and secrets
flask_config = "ascl_net.cfg"
secrets_file = "/etc/ascl/secrets.cfg"

# Typesense
typesense_url        = "http://127.0.0.1:8108"
typesense_collection = "codes"

# Library dependencies to sync and install during redeploy.
# Each [[vps.libs]] entry has repo (source) and deploy (destination) paths.
# Uncomment and set paths to enable:
# [[vps.libs]]
# repo   = "/path/to/ascl_core"
# deploy = "/var/www/ascl_core"
#
# [[vps.libs]]
# repo   = "/path/to/dm-dbcore"
# deploy = "/var/www/dm-dbcore"

# ---------------------------------------------------------------------------
# cPanel target — Phusion Passenger
# ---------------------------------------------------------------------------
[cpanel]
restart_method = "passenger"

# Source repository (for rsync during redeploy; leave empty if using git pull)
repo_app = ""

# cPanel app root (contains passenger_wsgi.py and tmp/restart.txt)
deploy_app = "~/ascl.net"

# On cPanel you run as yourself, leave empty
run_as_user = ""

# SSH access for remote deploy (leave empty to deploy locally on cPanel host)
ssh_host = ""
# ssh_host = "ascl.net"
# ssh_user = ""  # defaults to your local username

# Flask config and secrets
flask_config = "ascl_net.cfg"
secrets_file = ""

# Typesense (may be remote if cPanel can't run Typesense locally)
typesense_url        = ""
typesense_collection = "codes"
"""

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def _bold(text):
    return f"\033[1m{text}\033[0m"


def _green(text):
    return f"\033[92m{text}\033[0m"


def _yellow(text):
    return f"\033[93m{text}\033[0m"


def _red(text):
    return f"\033[91m{text}\033[0m"


def _step(msg):
    print(f"\n{_bold('==>')} {msg}")


def _run(cmd, check=True, capture=False):
    """Run a shell command, printing it first."""
    print(f"  $ {cmd}")
    if capture:
        return subprocess.run(cmd, shell=True, check=check,
                              capture_output=True, text=True)
    subprocess.run(cmd, shell=True, check=check)


def _require_root():
    if os.geteuid() != 0:
        print(_red("Error: this command must be run with sudo"))
        print(f"  sudo {' '.join(sys.argv)}")
        sys.exit(1)


def _load_config():
    """Load and return the parsed TOML config, creating a template if missing."""
    if not CONFIG_FILE.exists():
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        CONFIG_FILE.write_text(DEFAULT_CONFIG)
        print(_yellow(f"No config found — created template at {CONFIG_FILE}"))
        print(f"Edit it to match your environment, then re-run your command.\n")
        sys.exit(1)
    with open(CONFIG_FILE, "rb") as f:
        return tomllib.load(f)


def _resolve_target(args, config):
    """Return the target name from args or the default."""
    if hasattr(args, "target") and args.target:
        t = args.target
    else:
        t = config.get("default_target", "vps")
    if t not in config:
        print(_red(f"Unknown target '{t}'. Available: {', '.join(k for k in config if isinstance(config[k], dict))}"))
        sys.exit(1)
    return t, config[t]


def _rsync_excludes():
    return " ".join(f"--exclude='{e}'" for e in RSYNC_EXCLUDES)


# ---------------------------------------------------------------------------
# Restart strategies
# ---------------------------------------------------------------------------

def _restart_systemd(cfg):
    _require_root()
    service = cfg["service_name"]
    _run(f"systemctl restart {service}")
    time.sleep(1)
    _run(f"systemctl status {service} --no-pager", check=False)


def _restart_passenger(cfg):
    deploy = os.path.expanduser(cfg["deploy_app"])
    restart_file = os.path.join(deploy, "tmp", "restart.txt")

    ssh_host = cfg.get("ssh_host", "")
    if ssh_host:
        ssh_user = cfg.get("ssh_user", "")
        host = f"{ssh_user}@{ssh_host}" if ssh_user else ssh_host
        _run(f"ssh {host} 'mkdir -p {deploy}/tmp && touch {restart_file}'")
    else:
        os.makedirs(os.path.join(deploy, "tmp"), exist_ok=True)
        _run(f"touch {restart_file}")

    print(_green("Passenger will restart on next request."))


def _restart(target_name, cfg):
    method = cfg.get("restart_method", "systemd")
    _step(f"Restarting ({target_name} / {method})")

    if method == "systemd":
        _restart_systemd(cfg)
    elif method == "passenger":
        _restart_passenger(cfg)
    else:
        print(_red(f"Unknown restart_method: {method}"))
        sys.exit(1)


# ---------------------------------------------------------------------------
# Status strategies
# ---------------------------------------------------------------------------

def _status_systemd(cfg):
    service = cfg["service_name"]
    result = _run(f"systemctl status {service} --no-pager", check=False, capture=True)
    print(result.stdout)
    if result.stderr:
        print(result.stderr)


def _status_passenger(cfg):
    deploy = os.path.expanduser(cfg["deploy_app"])
    restart_file = os.path.join(deploy, "tmp", "restart.txt")

    ssh_host = cfg.get("ssh_host", "")
    if ssh_host:
        ssh_user = cfg.get("ssh_user", "")
        host = f"{ssh_user}@{ssh_host}" if ssh_user else ssh_host
        _run(f"ssh {host} 'ls -la {restart_file} 2>/dev/null; passenger-status 2>/dev/null || echo \"passenger-status not available\"'",
             check=False)
    else:
        if os.path.exists(restart_file):
            import datetime
            mtime = os.path.getmtime(restart_file)
            dt = datetime.datetime.fromtimestamp(mtime)
            print(f"Last restart requested: {dt}")
        else:
            print("No restart.txt found (app may not have been deployed yet).")


# ---------------------------------------------------------------------------
# Redeploy strategies
# ---------------------------------------------------------------------------

def _check_uncommitted(dirs, force=False):
    """Abort if any of the given directories have uncommitted git changes.

    Pass force=True to downgrade the error to a warning.
    """
    dirty = []
    for d in dirs:
        d = os.path.expanduser(d)
        if not os.path.isdir(os.path.join(d, ".git")):
            continue
        result = subprocess.run(
            ["git", "-C", d, "status", "--porcelain"],
            capture_output=True, text=True,
        )
        if result.stdout.strip():
            dirty.append(d)

    if not dirty:
        return

    for d in dirty:
        print(_yellow(f"  Uncommitted changes in {d}"))

    if force:
        print(_yellow("  --force: continuing anyway\n"))
    else:
        print(_red("\nAborting. Commit or stash changes first, or pass --force to override."))
        sys.exit(1)


def _sync_libs(cfg):
    """Rsync library dependencies listed in cfg['libs'] to their deploy paths."""
    libs = cfg.get("libs", [])
    if not libs:
        return
    excludes = _rsync_excludes()

    ssh_host = cfg.get("ssh_host", "")
    ssh_user = cfg.get("ssh_user", "")
    remote_prefix = ""
    if ssh_host:
        remote_prefix = f"{ssh_user}@{ssh_host}:" if ssh_user else f"{ssh_host}:"

    _step("Syncing library dependencies")
    for lib in libs:
        src = os.path.expanduser(lib["repo"])
        dst = os.path.expanduser(lib["deploy"])
        print(f"  {src} → {dst}")
        _run(f"rsync -a --delete {excludes} {src}/ {remote_prefix}{dst}/")


def _sync_app(cfg):
    """Rsync the app source to the deploy path."""
    src = cfg.get("repo_app", "")
    dst = cfg.get("deploy_app", "")
    if not src:
        print(_yellow("  (skipping sync — no repo_app configured)"))
        return
    src = os.path.expanduser(src)
    dst = os.path.expanduser(dst)

    ssh_host = cfg.get("ssh_host", "")
    ssh_user = cfg.get("ssh_user", "")
    remote_prefix = ""
    if ssh_host:
        remote_prefix = f"{ssh_user}@{ssh_host}:" if ssh_user else f"{ssh_host}:"

    excludes = _rsync_excludes()
    _step("Syncing application")
    _run(f"rsync -a --delete {excludes} {src}/ {remote_prefix}{dst}/")


def _set_ownership(cfg):
    user = cfg.get("run_as_user", "")
    if not user:
        return

    dirs = []
    deploy = os.path.expanduser(cfg.get("deploy_app", ""))
    if deploy:
        dirs.append(deploy)
    for lib in cfg.get("libs", []):
        dirs.append(os.path.expanduser(lib["deploy"]))

    if dirs:
        _step("Setting ownership")
        for d in dirs:
            _run(f"chown -R {user}:{user} {d}")


def _install_deps(cfg, use_ssh=False):
    _step("Installing dependencies")
    deploy = os.path.expanduser(cfg["deploy_app"])
    libs = cfg.get("libs", [])

    ssh_host = cfg.get("ssh_host", "")
    if use_ssh and ssh_host:
        ssh_user = cfg.get("ssh_user", "")
        host = f"{ssh_user}@{ssh_host}" if ssh_user else ssh_host
        _run(f"ssh {host} 'cd {deploy} && pip install -r requirements.txt'")
        return

    user = cfg.get("run_as_user", "")
    if user:
        venv = os.path.join(deploy, ".venv")
        env_vars = f"UV_CACHE_DIR=/var/cache/uv VIRTUAL_ENV={venv}"
        prefix = f"runuser -u {user} -- env {env_vars}"
        # Install library dependencies from their deploy paths
        for lib in libs:
            dst = os.path.expanduser(lib["deploy"])
            _run(f"{prefix} uv pip install {dst}")
        _run(f"{prefix} uv pip install -r {deploy}/requirements.txt")
    else:
        for lib in libs:
            dst = os.path.expanduser(lib["deploy"])
            _run(f"cd {dst} && pip install .")
        _run(f"cd {deploy} && pip install -r requirements.txt")


def _redeploy_vps(target_name, cfg, force=False):
    _require_root()

    secrets = cfg.get("secrets_file", "")
    if secrets and not os.path.isfile(secrets):
        print(_red(f"Error: {secrets} not found."))
        sys.exit(1)

    # Block on uncommitted changes unless --force
    repo_dirs = [cfg.get("repo_app", "")]
    repo_dirs += [lib["repo"] for lib in cfg.get("libs", [])]
    _check_uncommitted([d for d in repo_dirs if d], force=force)

    service = cfg["service_name"]

    _step("Stopping service")
    _run(f"systemctl stop {service}")

    _sync_libs(cfg)
    _sync_app(cfg)
    _set_ownership(cfg)
    _install_deps(cfg)

    _step("Starting service")
    _run(f"systemctl start {service}")
    time.sleep(1)

    _step("Status")
    _run(f"systemctl status {service} --no-pager", check=False)

    print(f"\n{_green('Deployment complete.')}")


def _redeploy_cpanel(target_name, cfg):
    _sync_app(cfg)
    _install_deps(cfg, use_ssh=bool(cfg.get("ssh_host")))

    _step("Restarting Passenger")
    _restart_passenger(cfg)

    print(f"\n{_green('cPanel deployment complete.')}")


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def cmd_restart(args):
    config = _load_config()
    target_name, cfg = _resolve_target(args, config)
    _restart(target_name, cfg)


def cmd_redeploy(args):
    config = _load_config()
    target_name, cfg = _resolve_target(args, config)
    force = getattr(args, "force", False)

    method = cfg.get("restart_method", "systemd")
    if method == "systemd":
        _redeploy_vps(target_name, cfg, force=force)
    elif method == "passenger":
        _redeploy_cpanel(target_name, cfg)
    else:
        print(_red(f"Unknown restart_method: {method}"))
        sys.exit(1)


def cmd_status(args):
    config = _load_config()
    target_name, cfg = _resolve_target(args, config)

    method = cfg.get("restart_method", "systemd")
    _step(f"Status ({target_name} / {method})")

    if method == "systemd":
        _status_systemd(cfg)
    elif method == "passenger":
        _status_passenger(cfg)
    else:
        print(_red(f"Unknown restart_method: {method}"))


def cmd_config(args):
    config = _load_config()
    target_name, cfg = _resolve_target(args, config)

    print(f"{_bold('Target:')} {target_name}")
    print(f"{_bold('Config:')} {CONFIG_FILE}\n")
    max_key = max(len(k) for k in cfg)
    for k, v in cfg.items():
        print(f"  {k:<{max_key}}  {v}")


def cmd_init(args):
    if CONFIG_FILE.exists() and not args.force:
        print(f"Config already exists: {CONFIG_FILE}")
        print(f"Use --force to overwrite.")
        sys.exit(1)

    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(DEFAULT_CONFIG)
    print(_green(f"Created {CONFIG_FILE}"))
    print(f"Edit it to match your environment, then run: ascl status")


def cmd_dumpdb(args):
    import shutil
    import tempfile
    from datetime import date

    db_name = args.database
    outfile = args.output or f"{db_name}_{date.today().isoformat()}.sql"
    host = args.host
    port = args.port
    suffix = "_ascl_root"

    # mysqldump chokes on client-only variables (e.g. "database=") in
    # [client_*] groups.  Work around by extracting just user/password
    # from the defaults-group-suffix via the mysql client, then writing
    # a minimal temporary options file for mysqldump.
    mycnf = pathlib.Path.home() / ".my.cnf"
    tmp_cnf = None
    cred_args = f"--defaults-group-suffix={suffix}"

    if mycnf.exists():
        import configparser
        cp = configparser.ConfigParser(interpolation=None)
        cp.read(str(mycnf))
        section = f"client{suffix}"
        if cp.has_section(section):
            user = cp.get(section, "user", fallback=None)
            password = cp.get(section, "password", fallback=None)
            h = cp.get(section, "host", fallback=None)
            p = cp.get(section, "port", fallback=None)
            if h:
                host = host or h
            if p:
                port = port or p

            if user:
                # Write a temp defaults file with only user+password
                tmp = tempfile.NamedTemporaryFile(mode="w", suffix=".cnf", delete=False)
                tmp.write("[mysqldump]\n")
                tmp.write(f"user={user}\n")
                if password:
                    tmp.write(f"password={password}\n")
                tmp.close()
                os.chmod(tmp.name, 0o600)
                tmp_cnf = tmp.name
                cred_args = f"--defaults-file={tmp_cnf}"

    _step(f"Dumping {db_name} → {outfile}")

    # --databases  => includes CREATE DATABASE IF NOT EXISTS + USE
    # --skip-add-drop-table => don't DROP TABLE before CREATE
    # Post-process to add IF NOT EXISTS to CREATE TABLE statements
    cmd = (
        f"mysqldump {cred_args}"
        f" -h {host or '127.0.0.1'} -P {port or '3307'}"
        f" --databases {db_name}"
        f" --skip-add-drop-table"
        f" --set-gtid-purged=OFF"
        f" > {outfile}"
    )
    try:
        _run(cmd)

        # mysqldump has no flag for CREATE TABLE IF NOT EXISTS;
        # patch it in-place.
        with open(outfile, "r") as f:
            sql = f.read()
        sql = sql.replace("CREATE TABLE ", "CREATE TABLE IF NOT EXISTS ")
        with open(outfile, "w") as f:
            f.write(sql)

        size = os.path.getsize(outfile)
        print(f"\n{_green('Done.')}  {outfile}  ({size:,} bytes)")
    finally:
        if tmp_cnf and os.path.exists(tmp_cnf):
            os.unlink(tmp_cnf)


def cmd_completions(args):
    if args.shell == "bash":
        print(BASH_COMPLETION)
    elif args.shell == "zsh":
        print(ZSH_COMPLETION)
    else:
        print(_red(f"Unknown shell: {args.shell}"))
        sys.exit(1)


# ---------------------------------------------------------------------------
# Shell completions
# ---------------------------------------------------------------------------

BASH_COMPLETION = r"""
# ascl bash completion
# Add to ~/.bashrc:  eval "$(ascl completions bash)"
_ascl_completions() {
    local cur prev commands targets
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    commands="restart redeploy status config dumpdb init completions typesense"
    targets="vps cpanel"

    case "$prev" in
        ascl)
            COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
            return 0
            ;;
        restart|redeploy|status|config)
            COMPREPLY=( $(compgen -W "$targets" -- "$cur") )
            return 0
            ;;
        completions)
            COMPREPLY=( $(compgen -W "bash zsh" -- "$cur") )
            return 0
            ;;
        init)
            COMPREPLY=( $(compgen -W "--force" -- "$cur") )
            return 0
            ;;
        typesense)
            COMPREPLY=( $(compgen -W "reset index status" -- "$cur") )
            return 0
            ;;
    esac
}
complete -F _ascl_completions ascl
""".strip()

ZSH_COMPLETION = r"""
# ascl zsh completion
# Add to ~/.zshrc:  eval "$(ascl completions zsh)"
_ascl() {
    local -a commands targets shells
    commands=(
        'restart:Restart the app'
        'redeploy:Full redeploy (sync, install, restart)'
        'status:Show app/service status'
        'config:Show resolved config for a target'
        'init:Create default config'
        'dumpdb:Dump MySQL database to dated .sql file'
        'completions:Print shell completion script'
        'typesense:Manage Typesense search index'
    )
    targets=('vps:Nginx + Uvicorn + systemd' 'cpanel:Phusion Passenger')
    shells=('bash' 'zsh')

    if (( CURRENT == 2 )); then
        _describe 'command' commands
    elif (( CURRENT == 3 )); then
        case "$words[2]" in
            restart|redeploy|status|config)
                _describe 'target' targets
                ;;
            completions)
                _describe 'shell' shells
                ;;
            init)
                _arguments '--force[Overwrite existing config]'
                ;;
            typesense)
                local -a ts_cmds
                ts_cmds=('reset:Drop, recreate, and re-index' 'index:Re-index all codes' 'status:Show collection info')
                _describe 'typesense command' ts_cmds
                ;;
        esac
    fi
}
compdef _ascl ascl
""".strip()


# ---------------------------------------------------------------------------
# ascl test
# ---------------------------------------------------------------------------

def cmd_test(args):
    """Run smoke tests against a live URL."""
    test_dir = pathlib.Path(__file__).resolve().parent.parent / "tests"
    if not (test_dir / "test_smoke.py").exists():
        print(f"Error: test_smoke.py not found in {test_dir}", file=sys.stderr)
        sys.exit(1)

    cmd = [sys.executable, "-m", "pytest", str(test_dir / "test_smoke.py"),
           "--base-url", args.url, "-v"]

    admin_user = args.admin_user or os.environ.get("ASCL_ADMIN_USER")
    admin_pass = args.admin_pass or os.environ.get("ASCL_ADMIN_PASSWORD")
    if admin_user and admin_pass:
        cmd += ["--admin-user", admin_user, "--admin-pass", admin_pass]

    if args.exitfirst:
        cmd.append("-x")

    sys.exit(subprocess.call(cmd))


# ---------------------------------------------------------------------------
# CLI entry point
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        prog="ascl",
        description="ASCL application management CLI",
    )
    sub = parser.add_subparsers(dest="command")

    # ascl restart [target]
    p = sub.add_parser("restart", help="Restart the app")
    p.add_argument("target", nargs="?", choices=TARGETS, help="Deployment target")
    p.set_defaults(func=cmd_restart)

    # ascl redeploy <target>
    p = sub.add_parser("redeploy", help="Full redeploy (sync, install, restart)")
    p.add_argument("target", nargs="?", choices=TARGETS, help="Deployment target")
    p.add_argument("--force", "-f", action="store_true",
                   help="Deploy even if repos have uncommitted changes")
    p.set_defaults(func=cmd_redeploy)

    # ascl status [target]
    p = sub.add_parser("status", help="Show app/service status")
    p.add_argument("target", nargs="?", choices=TARGETS, help="Deployment target")
    p.set_defaults(func=cmd_status)

    # ascl config [target]
    p = sub.add_parser("config", help="Show resolved config for a target")
    p.add_argument("target", nargs="?", choices=TARGETS, help="Deployment target")
    p.set_defaults(func=cmd_config)

    # ascl dumpdb <database>
    p = sub.add_parser("dumpdb", help="Dump a MySQL database to a dated .sql file")
    p.add_argument("database", help="Database name (e.g. ascl_db_v4)")
    p.add_argument("-o", "--output", help="Output filename (default: {db}_yyyy-mm-dd.sql)")
    p.add_argument("--host", help="MySQL host (default: from ~/.my.cnf or 127.0.0.1)")
    p.add_argument("--port", help="MySQL port (default: from ~/.my.cnf or 3307)")
    p.set_defaults(func=cmd_dumpdb)

    # ascl init
    p = sub.add_parser("init", help="Create default config at ~/.config/ascl/config.toml")
    p.add_argument("--force", action="store_true", help="Overwrite existing config")
    p.set_defaults(func=cmd_init)

    # ascl completions <shell>
    p = sub.add_parser("completions", help="Print shell completion script")
    p.add_argument("shell", choices=("bash", "zsh"), help="Shell type")
    p.set_defaults(func=cmd_completions)

    # ascl test <url> [--admin-user X --admin-pass Y] [-x]
    p = sub.add_parser("test", help="Run smoke tests against a live site")
    p.add_argument("url", help="Base URL to test (e.g. https://dev.ascl.net)")
    p.add_argument("--admin-user", help="Admin username (or set $ASCL_ADMIN_USER)")
    p.add_argument("--admin-pass", help="Admin password (or set $ASCL_ADMIN_PASSWORD)")
    p.add_argument("-x", "--exitfirst", action="store_true", help="Stop on first failure")
    p.set_defaults(func=cmd_test)

    # ascl typesense {reset,index,status}
    from ascl_typesense import register_subcommands as _register_ts
    _register_ts(sub, _load_config)

    # ascl linkcheck [options]
    from ascl_link_checker import register_subcommands as _register_lc
    _register_lc(sub, _load_config)

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(1)

    args.func(args)


if __name__ == "__main__":
    main()
