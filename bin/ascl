#!/usr/bin/env python3
"""
ascl — management CLI for the ASCL Flask application.

Usage:
    ascl restart [TARGET]      Restart the app (default target from config)
    ascl redeploy TARGET       Full redeploy (sync, install deps, restart)
    ascl status [TARGET]       Show app/service status
    ascl config                Show resolved config for a target
    ascl init                  Create default config at ~/.config/ascl/config.toml
    ascl completions bash      Print bash completion script
    ascl completions zsh       Print zsh completion script
"""

import argparse
import os
import pathlib
import subprocess
import sys
import time
import tomllib

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

CONFIG_DIR = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", pathlib.Path.home() / ".config")) / "ascl"
CONFIG_FILE = CONFIG_DIR / "config.toml"

TARGETS = ("vps", "cpanel")

RSYNC_EXCLUDES = [
    "venv", ".venv", "__pycache__", "*.pyc", ".git",
    "logs/*.log", "*.egg-info", ".uv", ".claude",
]

DEFAULT_CONFIG = """\
# ASCL CLI configuration
# Generated by: ascl init

default_target = "vps"

# ---------------------------------------------------------------------------
# VPS target — Nginx + Uvicorn + systemd (e.g. ascl.bistromath.net)
# ---------------------------------------------------------------------------
[vps]
restart_method = "systemd"
service_name   = "ascl_net_app"

# Where the running app lives
deploy_app       = "/var/www/ascl_net_app"
deploy_dmdbcore  = "/var/www/dm-dbcore"
deploy_ascl_core = "/var/www/ascl_core"

# Source repository paths (for rsync during redeploy)
repo_app       = "/home/demitri/repositories/ASCL/alt_ascl/source/ascl_net_app_project_home"
repo_dmdbcore  = "/home/demitri/repositories/ASCL/dm-dbcore"
repo_ascl_core = "/home/demitri/repositories/ASCL/ascl_core"

# File ownership after sync
run_as_user = "www-data"

# Flask config file to use
flask_config = "ascl_net.cfg"
secrets_file = "/etc/ascl/secrets.cfg"

# Typesense
typesense_url        = "http://127.0.0.1:8108"
typesense_collection = "codes"

# ---------------------------------------------------------------------------
# cPanel target — Phusion Passenger (e.g. ascl.net)
# ---------------------------------------------------------------------------
[cpanel]
restart_method = "passenger"

# cPanel app root (contains passenger_wsgi.py and tmp/restart.txt)
deploy_app       = "~/ascl.net"
deploy_dmdbcore  = "~/ascl.net/vendor/dm-dbcore"
deploy_ascl_core = "~/ascl.net/vendor/ascl_core"

# Source — can be local paths (if running on cPanel host) or empty (if using git pull)
repo_app       = ""
repo_dmdbcore  = ""
repo_ascl_core = ""

# On cPanel you run as yourself, leave empty
run_as_user = ""

# SSH access for remote deploy from VPS (leave empty to deploy locally on cPanel)
ssh_host = ""
# ssh_host = "ascl.net"
# ssh_user = ""  # defaults to your local username

flask_config = "ascl_net.cfg"
secrets_file = "~/etc/ascl/secrets.cfg"

# Typesense (may be remote if cPanel can't run Typesense locally)
typesense_url        = ""
typesense_collection = "codes"
"""

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def _bold(text):
    return f"\033[1m{text}\033[0m"


def _green(text):
    return f"\033[92m{text}\033[0m"


def _red(text):
    return f"\033[91m{text}\033[0m"


def _step(msg):
    print(f"\n{_bold('==>')} {msg}")


def _run(cmd, check=True, capture=False):
    """Run a shell command, printing it first."""
    print(f"  $ {cmd}")
    if capture:
        return subprocess.run(cmd, shell=True, check=check,
                              capture_output=True, text=True)
    subprocess.run(cmd, shell=True, check=check)


def _require_root():
    if os.geteuid() != 0:
        print(_red("Error: this command must be run with sudo"))
        print(f"  sudo {' '.join(sys.argv)}")
        sys.exit(1)


def _load_config():
    """Load and return the parsed TOML config, creating a template if missing."""
    if not CONFIG_FILE.exists():
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        CONFIG_FILE.write_text(DEFAULT_CONFIG)
        print(_yellow(f"No config found — created template at {CONFIG_FILE}"))
        print(f"Edit it to match your environment, then re-run your command.\n")
        sys.exit(1)
    with open(CONFIG_FILE, "rb") as f:
        return tomllib.load(f)


def _resolve_target(args, config):
    """Return the target name from args or the default."""
    if hasattr(args, "target") and args.target:
        t = args.target
    else:
        t = config.get("default_target", "vps")
    if t not in config:
        print(_red(f"Unknown target '{t}'. Available: {', '.join(k for k in config if isinstance(config[k], dict))}"))
        sys.exit(1)
    return t, config[t]


def _rsync_excludes():
    return " ".join(f"--exclude='{e}'" for e in RSYNC_EXCLUDES)


# ---------------------------------------------------------------------------
# Restart strategies
# ---------------------------------------------------------------------------

def _restart_systemd(cfg):
    _require_root()
    service = cfg["service_name"]
    _run(f"systemctl restart {service}")
    time.sleep(1)
    _run(f"systemctl status {service} --no-pager", check=False)


def _restart_passenger(cfg):
    deploy = os.path.expanduser(cfg["deploy_app"])
    restart_file = os.path.join(deploy, "tmp", "restart.txt")

    ssh_host = cfg.get("ssh_host", "")
    if ssh_host:
        ssh_user = cfg.get("ssh_user", "")
        host = f"{ssh_user}@{ssh_host}" if ssh_user else ssh_host
        _run(f"ssh {host} 'mkdir -p {deploy}/tmp && touch {restart_file}'")
    else:
        os.makedirs(os.path.join(deploy, "tmp"), exist_ok=True)
        _run(f"touch {restart_file}")

    print(_green("Passenger will restart on next request."))


def _restart(target_name, cfg):
    method = cfg.get("restart_method", "systemd")
    _step(f"Restarting ({target_name} / {method})")

    if method == "systemd":
        _restart_systemd(cfg)
    elif method == "passenger":
        _restart_passenger(cfg)
    else:
        print(_red(f"Unknown restart_method: {method}"))
        sys.exit(1)


# ---------------------------------------------------------------------------
# Status strategies
# ---------------------------------------------------------------------------

def _status_systemd(cfg):
    service = cfg["service_name"]
    result = _run(f"systemctl status {service} --no-pager", check=False, capture=True)
    print(result.stdout)
    if result.stderr:
        print(result.stderr)


def _status_passenger(cfg):
    deploy = os.path.expanduser(cfg["deploy_app"])
    restart_file = os.path.join(deploy, "tmp", "restart.txt")

    ssh_host = cfg.get("ssh_host", "")
    if ssh_host:
        ssh_user = cfg.get("ssh_user", "")
        host = f"{ssh_user}@{ssh_host}" if ssh_user else ssh_host
        _run(f"ssh {host} 'ls -la {restart_file} 2>/dev/null; passenger-status 2>/dev/null || echo \"passenger-status not available\"'",
             check=False)
    else:
        if os.path.exists(restart_file):
            import datetime
            mtime = os.path.getmtime(restart_file)
            dt = datetime.datetime.fromtimestamp(mtime)
            print(f"Last restart requested: {dt}")
        else:
            print("No restart.txt found (app may not have been deployed yet).")


# ---------------------------------------------------------------------------
# Redeploy strategies
# ---------------------------------------------------------------------------

def _sync_repos(cfg):
    """Rsync the three repos to their deploy paths."""
    excludes = _rsync_excludes()

    pairs = [
        ("application", cfg.get("repo_app"), cfg.get("deploy_app")),
        ("dm-dbcore",   cfg.get("repo_dmdbcore"), cfg.get("deploy_dmdbcore")),
        ("ascl_core",   cfg.get("repo_ascl_core"), cfg.get("deploy_ascl_core")),
    ]

    ssh_host = cfg.get("ssh_host", "")
    ssh_user = cfg.get("ssh_user", "")
    remote_prefix = ""
    if ssh_host:
        remote_prefix = f"{ssh_user}@{ssh_host}:" if ssh_user else f"{ssh_host}:"

    for label, src, dst in pairs:
        if not src:
            print(f"  (skipping {label} — no repo_* path configured)")
            continue
        src = os.path.expanduser(src)
        dst = os.path.expanduser(dst)

        _step(f"Syncing {label}")
        _run(f"rsync -a --delete {excludes} {src}/ {remote_prefix}{dst}/")


def _set_ownership(cfg):
    user = cfg.get("run_as_user", "")
    if not user:
        return

    _step("Setting ownership")
    for path_key in ("deploy_app", "deploy_dmdbcore", "deploy_ascl_core"):
        path = os.path.expanduser(cfg.get(path_key, ""))
        if path:
            _run(f"chown -R {user}:{user} {path}")


def _install_deps_vps(cfg):
    _step("Installing dependencies")
    deploy = cfg["deploy_app"]
    dmdbcore = cfg["deploy_dmdbcore"]
    ascl_core = cfg["deploy_ascl_core"]
    user = cfg.get("run_as_user", "")
    uv_env = "UV_CACHE_DIR=/var/cache/uv"

    if user:
        prefix = f"runuser -u {user} -- env {uv_env}"
    else:
        prefix = f"env {uv_env}"

    _run(f'{prefix} uv pip install "{dmdbcore}/[mysql]"')
    _run(f"{prefix} uv pip install {ascl_core}/")
    _run(f"{prefix} uv pip install -r {deploy}/requirements.txt")


def _install_deps_cpanel(cfg):
    _step("Installing dependencies")
    deploy = os.path.expanduser(cfg["deploy_app"])
    dmdbcore = os.path.expanduser(cfg["deploy_dmdbcore"])
    ascl_core = os.path.expanduser(cfg["deploy_ascl_core"])

    ssh_host = cfg.get("ssh_host", "")
    if ssh_host:
        ssh_user = cfg.get("ssh_user", "")
        host = f"{ssh_user}@{ssh_host}" if ssh_user else ssh_host
        cmds = " && ".join([
            f'cd {deploy}',
            f'pip install "{dmdbcore}/[mysql]"',
            f'pip install {ascl_core}/',
            f'pip install -r requirements.txt',
        ])
        _run(f"ssh {host} '{cmds}'")
    else:
        _run(f'cd {deploy} && pip install "{dmdbcore}/[mysql]"')
        _run(f"cd {deploy} && pip install {ascl_core}/")
        _run(f"cd {deploy} && pip install -r {deploy}/requirements.txt")


def _redeploy_vps(target_name, cfg):
    _require_root()

    secrets = cfg.get("secrets_file", "")
    if secrets and not os.path.isfile(secrets):
        print(_red(f"Error: {secrets} not found."))
        sys.exit(1)

    service = cfg["service_name"]

    _step("Stopping service")
    _run(f"systemctl stop {service}")

    _sync_repos(cfg)
    _set_ownership(cfg)
    _install_deps_vps(cfg)

    _step("Starting service")
    _run(f"systemctl start {service}")
    time.sleep(1)

    _step("Status")
    _run(f"systemctl status {service} --no-pager", check=False)

    print(f"\n{_green('Deployment complete.')}")


def _redeploy_cpanel(target_name, cfg):
    _sync_repos(cfg)
    _install_deps_cpanel(cfg)

    _step("Restarting Passenger")
    _restart_passenger(cfg)

    print(f"\n{_green('cPanel deployment complete.')}")


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def cmd_restart(args):
    config = _load_config()
    target_name, cfg = _resolve_target(args, config)
    _restart(target_name, cfg)


def cmd_redeploy(args):
    config = _load_config()
    target_name, cfg = _resolve_target(args, config)

    method = cfg.get("restart_method", "systemd")
    if method == "systemd":
        _redeploy_vps(target_name, cfg)
    elif method == "passenger":
        _redeploy_cpanel(target_name, cfg)
    else:
        print(_red(f"Unknown restart_method: {method}"))
        sys.exit(1)


def cmd_status(args):
    config = _load_config()
    target_name, cfg = _resolve_target(args, config)

    method = cfg.get("restart_method", "systemd")
    _step(f"Status ({target_name} / {method})")

    if method == "systemd":
        _status_systemd(cfg)
    elif method == "passenger":
        _status_passenger(cfg)
    else:
        print(_red(f"Unknown restart_method: {method}"))


def cmd_config(args):
    config = _load_config()
    target_name, cfg = _resolve_target(args, config)

    print(f"{_bold('Target:')} {target_name}")
    print(f"{_bold('Config:')} {CONFIG_FILE}\n")
    max_key = max(len(k) for k in cfg)
    for k, v in cfg.items():
        print(f"  {k:<{max_key}}  {v}")


def cmd_init(args):
    if CONFIG_FILE.exists() and not args.force:
        print(f"Config already exists: {CONFIG_FILE}")
        print(f"Use --force to overwrite.")
        sys.exit(1)

    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(DEFAULT_CONFIG)
    print(_green(f"Created {CONFIG_FILE}"))
    print(f"Edit it to match your environment, then run: ascl status")


def cmd_completions(args):
    if args.shell == "bash":
        print(BASH_COMPLETION)
    elif args.shell == "zsh":
        print(ZSH_COMPLETION)
    else:
        print(_red(f"Unknown shell: {args.shell}"))
        sys.exit(1)


# ---------------------------------------------------------------------------
# Shell completions
# ---------------------------------------------------------------------------

BASH_COMPLETION = r"""
# ascl bash completion
# Add to ~/.bashrc:  eval "$(ascl completions bash)"
_ascl_completions() {
    local cur prev commands targets
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    commands="restart redeploy status config init completions"
    targets="vps cpanel"

    case "$prev" in
        ascl)
            COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
            return 0
            ;;
        restart|redeploy|status|config)
            COMPREPLY=( $(compgen -W "$targets" -- "$cur") )
            return 0
            ;;
        completions)
            COMPREPLY=( $(compgen -W "bash zsh" -- "$cur") )
            return 0
            ;;
        init)
            COMPREPLY=( $(compgen -W "--force" -- "$cur") )
            return 0
            ;;
    esac
}
complete -F _ascl_completions ascl
""".strip()

ZSH_COMPLETION = r"""
# ascl zsh completion
# Add to ~/.zshrc:  eval "$(ascl completions zsh)"
_ascl() {
    local -a commands targets shells
    commands=(
        'restart:Restart the app'
        'redeploy:Full redeploy (sync, install, restart)'
        'status:Show app/service status'
        'config:Show resolved config for a target'
        'init:Create default config'
        'completions:Print shell completion script'
    )
    targets=('vps:Nginx + Uvicorn + systemd' 'cpanel:Phusion Passenger')
    shells=('bash' 'zsh')

    if (( CURRENT == 2 )); then
        _describe 'command' commands
    elif (( CURRENT == 3 )); then
        case "$words[2]" in
            restart|redeploy|status|config)
                _describe 'target' targets
                ;;
            completions)
                _describe 'shell' shells
                ;;
            init)
                _arguments '--force[Overwrite existing config]'
                ;;
        esac
    fi
}
compdef _ascl ascl
""".strip()


# ---------------------------------------------------------------------------
# CLI entry point
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        prog="ascl",
        description="ASCL application management CLI",
    )
    sub = parser.add_subparsers(dest="command")

    # ascl restart [target]
    p = sub.add_parser("restart", help="Restart the app")
    p.add_argument("target", nargs="?", choices=TARGETS, help="Deployment target")
    p.set_defaults(func=cmd_restart)

    # ascl redeploy <target>
    p = sub.add_parser("redeploy", help="Full redeploy (sync, install, restart)")
    p.add_argument("target", nargs="?", choices=TARGETS, help="Deployment target")
    p.set_defaults(func=cmd_redeploy)

    # ascl status [target]
    p = sub.add_parser("status", help="Show app/service status")
    p.add_argument("target", nargs="?", choices=TARGETS, help="Deployment target")
    p.set_defaults(func=cmd_status)

    # ascl config [target]
    p = sub.add_parser("config", help="Show resolved config for a target")
    p.add_argument("target", nargs="?", choices=TARGETS, help="Deployment target")
    p.set_defaults(func=cmd_config)

    # ascl init
    p = sub.add_parser("init", help="Create default config at ~/.config/ascl/config.toml")
    p.add_argument("--force", action="store_true", help="Overwrite existing config")
    p.set_defaults(func=cmd_init)

    # ascl completions <shell>
    p = sub.add_parser("completions", help="Print shell completion script")
    p.add_argument("shell", choices=("bash", "zsh"), help="Shell type")
    p.set_defaults(func=cmd_completions)

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(1)

    args.func(args)


if __name__ == "__main__":
    main()
